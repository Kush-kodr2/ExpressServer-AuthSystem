<!DOCTYPE html>
<html>

<head>
  <title>Task 7</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <style>
    .navbar-brand h2 {
      transition: transform 0.3s ease;
    }

    .navbar-brand h2:hover {
      color: #FFD700;
      transform: scale(1.1);
    }

    .card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
      transform: translateY(-10px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    }

    footer {
      background: #212529;
      color: #fff;
    }
  </style>

</head>

<body class="bg-light d-flex flex-column min-vh-100">

  <nav class="navbar navbar-dark" style="background-color: #4169E1;">
    <div class="container">
      <span class="navbar-brand">
        <h2>User Registration Demo</h2>
      </span>
    </div>
  </nav>


  <div class="container my-5">
    <div class="row g-4">

      <!-- Form Section -->
      <div class="col-md-6">
        <div class="card p-4">
          <h4>User Registration</h4>
          <form id="userForm" onsubmit="submitForm(event)">
            <div class="mb-3">
              <input class="form-control" type="text" id="username" name="username" placeholder="Username" required>
            </div>

            <div class="mb-3">
              <input class="form-control" type="email" id="email" name="email" placeholder="Email" required>
            </div>
            <div class="mb-3">
              <input class="form-control" type="number" id="age" name="age" placeholder="Age" required>
            </div>
            <div class="mb-3">
              <input class="form-control" type="password" id="password" name="password" placeholder="Password" required>
              <small id="passwordStrength"></small>
            </div>
            <button class="btn btn-primary w-100" type="submit">Submit</button>
            <p>Already have an account? <a href="#" onclick="switch_to_login()">Login here</a></p>
          </form>

          <form id="LoginForm" style="display:none;" onsubmit="loginForm(event)">
            <div class="mb-3">
              <input class="form-control" type="email" id="loginEmail" name="loginEmail" placeholder="Email" required>
            </div>
            <div class="mb-3">
              <input class="form-control" type="password" id="loginPassword" name="loginPassword"
                placeholder="Password" required>
            </div>
            <button class="btn btn-primary w-100" type="submit">Login</button>
            <p>Don't have an account? <a href="#" onclick="switch_to_register()">Register here</a></p>
          </form>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card p-4">
          <h4>Response</h4>
          <p id="apiResponse" class="mt-3"></p>
          <!-- Server-side error message -->
          <% if(typeof error !=="undefined" ) { %>
            <p style="color:red;">
              <%= error %>
            </p>
            <% } %>
              <!-- Client-side error message -->
              <p id="error" style="color:red;"></p>
              <button class="btn btn-secondary mb-3" id="toggleUsersBtn" onclick="toggleUsers()">
                Get All Users</button>
              <ul id="userList" class="list-group" style="display: none;"></ul>
        </div>
      </div>

    </div>
  </div>
  <footer class="text-center py-3 mt-auto">
    <small>© 2025 Kushal Project</small>
  </footer>
  <script>
    function switch_to_login() {
      document.getElementById("userForm").style.display = "none";
      document.getElementById("LoginForm").style.display = "block";
      document.getElementById("apiResponse").innerText = "";
      document.getElementById("error").innerText = "";
    }
    function switch_to_register() {
      document.getElementById("userForm").style.display = "block";
      document.getElementById("LoginForm").style.display = "none";
      document.getElementById("apiResponse").innerText = "";
      document.getElementById("error").innerText = "";
    }
    async function submitForm(event) {
      event.preventDefault(); // Prevent default form submission

      if (!validateForm()) {
        return;
      }
      const name = document.getElementById("username").value;
      const email = document.getElementById("email").value;
      const age = document.getElementById("age").value;
      const password = document.getElementById("password").value;
      try {
        const response = await fetch("/api/users", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ username: name, email, age, password })
        });
        const data = await response.json();

        document.getElementById("apiResponse").innerText = data.message;
        document.getElementById("error").innerText = "";

        // Clear the input fields after successful submission
        if (data.success) {
          // Store token and redirect to dashboard
          localStorage.setItem("authToken", data.token);
          document.getElementById("apiResponse").innerText = data.message + " Redirecting to dashboard...";
          setTimeout(() => {
            window.location.href = "/dashboard";
          }, 1000);
        }
      } catch (error) {
        document.getElementById("error").innerText = "Error: Server is not running or network error!";
        console.error("Fetch error:", error);
      }
    }

    let usersVisible = false;

    async function toggleUsers() {
      const list = document.getElementById("userList");
      const btn = document.getElementById("toggleUsersBtn");

      if (usersVisible) {
        // Hide the user list
        list.style.display = "none";
        btn.innerText = "Get All Users";
        usersVisible = false;
      } else {
        // Fetch and show the user list
        await getUsers();
        list.style.display = "block";
        btn.innerText = "Hide All Users";
        usersVisible = true;
      }
    }
    async function loginForm(event){
      event.preventDefault();
      
      const email = document.getElementById("loginEmail").value;
      const password = document.getElementById("loginPassword").value;
      
      try{
        const response = await fetch("/api/login", {
          method: "POST", 
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ email, password })
        });
        const data =  await response.json();

        document.getElementById("apiResponse").innerText = data.message;
        document.getElementById("error").innerText = "";

      //if login is successful, store the token
        if(data.success && data.token){
        // In real applications, store the token securely (e.g., HttpOnly cookies)
        localStorage.setItem("authToken", data.token);
        document.getElementById("apiResponse").innerText = data.message + " Redirecting to dashboard...";
        setTimeout(() => {
          window.location.href = "/dashboard";
        }, 1000);
      }
      }catch(error){
        document.getElementById("error").innerText = "Login failed. Please try again.";
      }
      
      
    }

    async function getUsers() {
      try {
        const response = await fetch("/api/users");
        const data = await response.json();

        const list = document.getElementById("userList");
        list.innerHTML = ""; // clear old data

        if (data.users.length === 0) {
          list.innerHTML = '<li class="list-group-item text-muted">No users found. Add a user first!</li>';
          return;
        }

        data.users.forEach(user => {
          const li = document.createElement("li");
          li.className = "list-group-item";
          li.innerText = `${user.username} (${user.email}, ${user.age})`;
          list.appendChild(li);
        });
        document.getElementById("error").innerText = "";
      } catch (error) {
        document.getElementById("error").innerText = "Error: Server is not running or network error!";
        console.error("Fetch error:", error);
      }
    }

    const passwordInput = document.getElementById("password");
    passwordInput.addEventListener("input", () => {
      const strengthIndicator = document.getElementById("passwordStrength");
      const value = passwordInput.value;
      
      let strength = 0;
      
      // Calculate strength score
      if (value.length >= 6) strength++;
      if (value.length >= 10) strength++;
      if (/[a-z]/.test(value) && /[A-Z]/.test(value)) strength++;
      if (/\d/.test(value)) strength++;
      if (/[^A-Za-z0-9]/.test(value)) strength++; // Special characters
      
      // Display strength
      if (value.length === 0) {
        strengthIndicator.innerText = "";
        strengthIndicator.className = "";
      } else if (strength <= 1) {
        strengthIndicator.innerText = "⚠️ Very Weak";
        strengthIndicator.className = "text-danger";
      } else if (strength === 2) {
        strengthIndicator.innerText = "⚠️ Weak";
        strengthIndicator.className = "text-warning";
      } else if (strength === 3) {
        strengthIndicator.innerText = "✓ Medium";
        strengthIndicator.className = "text-info";
      } else if (strength === 4) {
        strengthIndicator.innerText = "✓ Strong";
        strengthIndicator.className = "text-success";
      } else {
        strengthIndicator.innerText = "✓✓ Very Strong";
        strengthIndicator.className = "text-success fw-bold";
      }
    });

    function validateForm() {
      const name = document.getElementById("username").value;
      const email = document.getElementById("email").value;
      const age = document.getElementById("age").value;
      const password = document.getElementById("password").value;
      if (name === "" || email === "" || age === "" || password === "") {
        document.getElementById("error").innerText =
          "All fields are required!";
        return false;
      }
      if (isNaN(age) || age <= 0) {
        document.getElementById("error").innerText =
          "Please enter a valid age.";
        return false;
      }
      if (age < 18) {
        document.getElementById("error").innerText =
          "You must be at least 18 years old to submit the form.";
        return false;
      }
      
      // Basic password requirements (minimum security)
      if (password.length < 6) {
        document.getElementById("error").innerText =
          "Password must be at least 6 characters long.";
        return false;
      }

      return true;
    }
  </script>

</body>

</html>